generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum PriceMode {
  FIXED
  QUOTE_REQUIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  UNVERIFIED
  VERIFIED
  FAILED
  REFUNDED
}

enum FulfillmentMethod {
  DELIVERY
  COLLECTION
}

enum QuoteStatus {
  OPEN
  IN_REVIEW
  QUOTED
  ACCEPTED
  REJECTED
  CLOSED
}

enum BookingStatus {
  PENDING
  APPROVED
  RESCHEDULED
  REJECTED
  COMPLETED
}

enum MessageStatus {
  UNREAD
  READ
  HANDLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

model AdminUser {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String
  credentialVersion Int    @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
  sessions     AdminSession[]
  emailChange  AdminEmailChange?
}

model AdminSession {
  id        String    @id
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  credentialVersion Int @default(0)

  @@index([adminId, expiresAt])
}

model AdminEmailChange {
  id                String    @id @default(cuid())
  adminId           String    @unique
  admin             AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  currentEmail      String
  newEmail          String
  credentialVersion Int
  tokenHash         String    @unique
  expiresAt         DateTime
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
}

model AuthRateLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Category {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameEn        String
  nameFr        String
  descriptionEn String    @default("")
  descriptionFr String    @default("")
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
}

model Product {
  id                     String           @id @default(cuid())
  slug                   String           @unique
  sku                    String?          @unique
  categoryId             String
  category               Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                  String           @default("")
  model                  String           @default("")
  nameEn                 String
  nameFr                 String
  isUndersale            Boolean          @default(false)
  shortDescription       String           @default("")
  specifications         Json             @default("[]")
  isAvailable            Boolean          @default(true)
  descriptionEn          String           @default("")
  descriptionFr          String           @default("")
  condition              ProductCondition @default(NEW)
  priceMode              PriceMode        @default(FIXED)
  price                  Decimal?         @db.Decimal(12, 2)
  stockQuantity          Int              @default(0)
  installationAvailable Boolean          @default(false)
  isPublished            Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  images                 ProductImage[]
  orderItems             OrderItem[]

  @@index([categoryId, isPublished])
  @@index([nameEn, nameFr])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String   @default("")
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Order {
  id                String             @id @default(cuid())
  reference         String             @unique
  clientReference   String?            @unique
  customerName      String
  customerPhone     String
  customerEmail     String?
  fulfillment       FulfillmentMethod
  deliveryAddress   String?
  notes             String?
  locale            String             @default("en")
  total             Decimal            @db.Decimal(12, 2)
  status            OrderStatus        @default(PENDING)
  paymentStatus     PaymentStatus      @default(UNVERIFIED)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             OrderItem[]
  payment           Payment?

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSlug    String
  productName    String
  sku            String   @default("")
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)

  @@index([orderId])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method     String        @default("MANUAL")
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus @default(UNVERIFIED)
  verifiedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model QuotationRequest {
  id              String     @id @default(cuid())
  reference       String     @unique
  name            String
  phone           String
  email           String?
  productOrService String
  location        String
  contactMethod   String     @default("WhatsApp")
  details         String
  locale          String     @default("en")
  status          QuoteStatus @default(OPEN)
  quotedAmount    Decimal?   @db.Decimal(12, 2)
  adminNotes      String     @default("")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, createdAt])
}

model TechnicianBooking {
  id             String        @id @default(cuid())
  reference      String        @unique
  name           String
  phone          String
  email          String?
  service        String
  preferredDate  DateTime
  preferredTime  String
  location       String
  details        String
  locale         String        @default("en")
  status         BookingStatus @default(PENDING)
  scheduledAt    DateTime?
  adminNotes     String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, preferredDate])
}

model ContactMessage {
  id        String        @id @default(cuid())
  reference String        @unique
  name      String
  phone     String
  email     String?
  message   String
  locale    String        @default("en")
  status    MessageStatus @default(UNREAD)
  adminNotes String       @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model Review {
  id         String       @id @default(cuid())
  reference  String       @unique @default(cuid())
  name       String
  rating     Int
  experience String
  locale     String       @default("en")
  status     ReviewStatus @default(PENDING)
  adminNotes String       @default("")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
}

model CompanySettings {
  id           String   @id @default("default")
  ceoWhatsapp  String   @default("")
  companyName  String   @default("BMTECH")
  phone        String   @default("0788494513")
  whatsapp     String   @default("250788494513")
  email        String   @default("")
  businessHours String  @default("")
  aboutEn      String   @default("")
  aboutFr      String   @default("")
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime  @default(now())

  @@index([entity, entityId, createdAt])
}
