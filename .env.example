PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://bmtech_dev:bmtech_dev@localhost:5432/bmtech?schema=public
DIRECT_URL=postgresql://bmtech_dev:bmtech_dev@localhost:5432/bmtech?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-different-long-random-one-time-setup-token
PUBLIC_API_ORIGIN=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3002
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_BYTES=4000000
BLOB_READ_WRITE_TOKEN=
BMTECH_NOTIFICATION_EMAIL=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=BMTECH <notifications@example.com>

# For durable-volume hosting only; configure BLOB_READ_WRITE_TOKEN on ephemeral hosts.
PERSISTENT_UPLOADS=false
